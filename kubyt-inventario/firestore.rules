rules_version = '2';

// Reglas de seguridad de KUBYT · Inventario
// Solo las personas registradas en la colección `usuarios` (con un rol) pueden usar la app.
// Crear una cuenta no basta: alguien con rol "admin" debe darla de alta.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function profile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function isAdmin() {
      return isMember() && profile().rol == 'admin';
    }

    // Perfiles: cada persona lee el suyo; solo admin gestiona perfiles.
    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Datos del negocio (insumos, productos, ventas, gastos…): solo miembros.
    // En fases siguientes se pueden afinar permisos por rol.
    match /{coleccion}/{docId} {
      allow read, write: if isMember() && coleccion != 'usuarios';
    }
  }
}
